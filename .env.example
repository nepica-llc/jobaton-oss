# Jobaton OSS — Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (can also be set in the Settings UI)
OPENAI_API_KEY=sk-your-key-here

# API port (default: 3001)
API_PORT=3001

# Data directory for local JSON storage
DATA_DIR=./data

# Bind address (default 127.0.0.1; the Docker image uses 0.0.0.0 inside the container)
# HOST=127.0.0.1

# Comma-separated origins allowed to call the API cross-origin (default: none)
# CORS_ORIGIN=http://localhost:5173
